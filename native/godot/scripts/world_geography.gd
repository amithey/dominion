static func window(key: String) -> Array:
	return MAPS[key].window

## World position (x, z) of longitude/latitude on map `key` of width `size`.
static func to_world(key: String, size: float, lon: float, lat: float) -> Vector2:
	var w: Array = MAPS[key].window
	return Vector2((lon - w[0]) / (w[1] - w[0]) * size - size * 0.5, (w[3] - lat) / (w[3] - w[2]) * size - size * 0.5)

## The land of map `key` as a grid of `cells` x `cells`: a signed distance to
## the coast in metres (positive on land) and a mountain strength 0..1.
static func raster(key: String, size: float, cells: int) -> Dictionary:
	var w: Array = MAPS[key].window
	var mask := PackedByteArray()
	mask.resize(cells * cells)
	var lands: Array = [MAINLAND] + ISLANDS.values()
	var seas: Array = SEAS.values()
	var lon_of := func(c: float) -> float: return w[0] + (c + 0.5) / cells * (w[1] - w[0])
	for row in range(cells):
		var lat: float = w[3] - (row + 0.5) / cells * (w[3] - w[2])
		var land_x: Array = _crossings(lands, lat)
		var sea_x: Array = _crossings(seas, lat)
		for col in range(cells):
			var lon: float = lon_of.call(float(col))
			var inside := _inside(land_x, lon) and not _inside(sea_x, lon)
			mask[row * cells + col] = 1 if inside else 0
	var cell_m: float = size / cells
	var land_d := _distance(mask, cells, 0)   # for land cells: to the nearest sea
	var sea_d := _distance(mask, cells, 1)    # for sea cells: to the nearest land
	var sdf := PackedFloat32Array()
	sdf.resize(cells * cells)
	for i in range(cells * cells):
		sdf[i] = (land_d[i] if mask[i] == 1 else -sea_d[i]) * cell_m
	var mountains := PackedFloat32Array()
	mountains.resize(cells * cells)
	for r in RANGES:
		var width: float = r[0] * 1.8   # (a range is broad: foothills either side)
		var line: Array = r[1]
		for i in range(line.size() - 1):
			var a: Array = line[i]
			var b: Array = line[i + 1]
			var lo_lon: float = minf(a[0], b[0]) - width
			var hi_lon: float = maxf(a[0], b[0]) + width
			var lo_lat: float = minf(a[1], b[1]) - width
			var hi_lat: float = maxf(a[1], b[1]) + width
			var c0: int = clampi(int((lo_lon - w[0]) / (w[1] - w[0]) * cells), 0, cells - 1)
			var c1: int = clampi(int((hi_lon - w[0]) / (w[1] - w[0]) * cells), 0, cells - 1)
			var r0: int = clampi(int((w[3] - hi_lat) / (w[3] - w[2]) * cells), 0, cells - 1)
			var r1: int = clampi(int((w[3] - lo_lat) / (w[3] - w[2]) * cells), 0, cells - 1)
			if hi_lon < w[0] or lo_lon > w[1] or hi_lat < w[2] or lo_lat > w[3]:
				continue
			var pa := Vector2(a[0], a[1])
			var pb := Vector2(b[0], b[1])
			for row in range(r0, r1 + 1):
				var lat: float = w[3] - (row + 0.5) / cells * (w[3] - w[2])
				for col in range(c0, c1 + 1):
					var p := Vector2(lon_of.call(float(col)), lat)
					var ab := pb - pa
					var t := clampf((p - pa).dot(ab) / maxf(ab.length_squared(), 0.0001), 0.0, 1.0)
					var dd := p.distance_to(pa + ab * t)
					if dd < width:
						var strength := 1.0 - dd / width
						mountains[row * cells + col] = maxf(mountains[row * cells + col], strength)
	return {"cells": cells, "sdf": sdf, "mountains": mountains}

## Longitudes where the edges of `polys` cross latitude `lat`, sorted.
static func _crossings(polys: Array, lat: float) -> Array:
	var out: Array = []
	for poly in polys:
		var n: int = poly.size()
		for i in range(n):
			var a: Array = poly[i]
			var b: Array = poly[(i + 1) % n]
			if (a[1] > lat) != (b[1] > lat):
				out.append(a[0] + (lat - a[1]) / (b[1] - a[1]) * (b[0] - a[0]))
	out.sort()
	return out

## Inside by the even-odd rule.
static func _inside(xs: Array, lon: float) -> bool:
	var n := 0
	for x in xs:
		if x < lon: n += 1
		else: break
	return n % 2 == 1

## For each cell whose mask is not `target`, the distance (in cells) to the
## nearest cell whose mask is `target` (two-pass chamfer, 1 and 1.4).
static func _distance(mask: PackedByteArray, n: int, target: int) -> PackedFloat32Array:
	var d := PackedFloat32Array()
	d.resize(n * n)
	for i in range(n * n):
		d[i] = 0.0 if mask[i] == target else 1e6
	for r in range(n):
		for c in range(n):
			var i := r * n + c
			if d[i] == 0.0: continue
			var best: float = d[i]
			if c > 0: best = minf(best, d[i - 1] + 1.0)
			if r > 0:
				best = minf(best, d[i - n] + 1.0)
				if c > 0: best = minf(best, d[i - n - 1] + 1.4)
				if c < n - 1: best = minf(best, d[i - n + 1] + 1.4)
			d[i] = best
	for r in range(n - 1, -1, -1):
		for c in range(n - 1, -1, -1):
			var i := r * n + c
			if d[i] == 0.0: continue
			var best: float = d[i]
			if c < n - 1: best = minf(best, d[i + 1] + 1.0)
			if r < n - 1:
				best = minf(best, d[i + n] + 1.0)
				if c < n - 1: best = minf(best, d[i + n + 1] + 1.4)
				if c > 0: best = minf(best, d[i + n - 1] + 1.4)
			d[i] = best
	return d
