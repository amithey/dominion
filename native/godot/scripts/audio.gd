extends Node3D
## Positional battle sound and adaptive 3-state music for the native world.
## Sounds come from res://audio (generated by tools/make-sounds.gd and
## tools/make-music.gd; any file can be replaced by a recording of the same name).
## One-shots play from a pool of 3D players; the listener sits on the ground at
## the camera focus, because an RTS camera is too high for natural distance
## fall-off. Distant sounds are quieter and muffled by the players' attenuation
## filter. An "SFX" bus adds a little open-air reverb and a limiter keeps many
## explosions from clipping.

const POOL_SIZE := 36
const VARIANTS := {"rifle": 3, "explosion": 3, "impact": 2}

var _streams := {}
var _pool: Array[AudioStreamPlayer3D] = []
var _next := 0
var _listener: AudioListener3D
var _wind: AudioStreamPlayer
var _surf: AudioStreamPlayer3D
var _music: AudioStreamPlayer
var _tension_music: AudioStreamPlayer
var _battle_music: AudioStreamPlayer
var _battle_hold := 0.0
var _battle_mix := 0.0
var _war_tension := 0.0
var _war_target := 0.0
var _focus := Vector3.ZERO
var _click: AudioStreamPlayer
var _feedback: AudioStreamPlayer
var _cues := {}
var _recent := {}  # name -> times played this frame, to cap stacked rifles

func _ready() -> void:
	_setup_buses()
	for name in [
		"cannon", "artillery_fire", "missile_launch", "nuke_blast", "mg_burst", "siren_short",
		"engine_loop", "tank_loop", "jet_loop", "heli_loop", "ship_loop",
		"wind_loop", "surf_loop"
	]:
		var path := "res://audio/%s.wav" % name
		if ResourceLoader.exists(path):
			_streams[name] = load(path)
	for name in VARIANTS:
		for i in range(VARIANTS[name]):
			var path := "res://audio/%s_%d.wav" % [name, i + 1]
			if ResourceLoader.exists(path):
				_streams["%s_%d" % [name, i + 1]] = load(path)
	for i in range(POOL_SIZE):
		var p := AudioStreamPlayer3D.new()
		p.bus = "SFX"
		p.max_distance = 440.0
		p.attenuation_filter_cutoff_hz = 3200.0
		p.attenuation_filter_db = -20.0
		add_child(p)
		_pool.append(p)
	_listener = AudioListener3D.new()
	add_child(_listener)
	_listener.make_current()
	_wind = AudioStreamPlayer.new()
	_wind.stream = _streams.get("wind_loop")
	_wind.volume_db = -24.0
	_wind.bus = "SFX"
	add_child(_wind)
	if _wind.stream != null:
		_wind.play()
	_surf = AudioStreamPlayer3D.new()
	_surf.stream = _streams.get("surf_loop")
	_surf.unit_size = 30.0
	_surf.max_distance = 260.0
	_surf.volume_db = -10.0
	_surf.bus = "SFX"
	add_child(_surf)
	if _surf.stream != null:
		_surf.play()
	# Music (tools/make-music.gd): 3-tier adaptive music (peace -> war tension -> active battle).
	_music = AudioStreamPlayer.new()
	_music.stream = load("res://audio/music_loop.wav")
	_music.bus = "Music"
	_music.volume_db = -9.0
	_music.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_music)
	_music.play()

	_tension_music = AudioStreamPlayer.new()
	if ResourceLoader.exists("res://audio/tension_loop.wav"):
		_tension_music.stream = load("res://audio/tension_loop.wav")
	_tension_music.bus = "Music"
	_tension_music.volume_db = -80.0
	_tension_music.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_tension_music)
	if _tension_music.stream != null:
		_tension_music.play()

	_battle_music = AudioStreamPlayer.new()
	_battle_music.stream = load("res://audio/battle_loop.wav")
	_battle_music.bus = "Music"
	_battle_music.volume_db = -80.0
	_battle_music.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_battle_music)
	_battle_music.play()
	# A soft click on every button, wherever it is.
	_click = AudioStreamPlayer.new()
	_click.stream = load("res://audio/ui_click.wav")
	_click.bus = "Interface"
	_click.volume_db = -14.0
	_click.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_click)
	_feedback = AudioStreamPlayer.new()
	_feedback.bus = "Interface"
	_feedback.volume_db = -14.0
	_feedback.process_mode = Node.PROCESS_MODE_ALWAYS
	add_child(_feedback)
	for cue in ["ready", "accepted", "rejected", "counter", "alert"]:
		_cues[cue] = _cue(cue)
	get_tree().node_added.connect(_on_node_added)
	for b in get_tree().root.find_children("*", "BaseButton", true, false):
		_on_node_added(b)

func _on_node_added(node: Node) -> void:
	if node is BaseButton and not node.has_meta("clicks"):
		node.set_meta("clicks", true)
		node.pressed.connect(_play_click)

func _play_click() -> void:
	if _click != null and is_instance_valid(_click):
		_click.play()

func _setup_buses() -> void:
	for extra in ["Music", "Interface"]:
		if AudioServer.get_bus_index(extra) == -1:
			AudioServer.add_bus()
			AudioServer.set_bus_name(AudioServer.bus_count - 1, extra)
			AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
	if AudioServer.get_bus_index("SFX") != -1:
		return
	AudioServer.add_bus()
	var sfx := AudioServer.bus_count - 1
	AudioServer.set_bus_name(sfx, "SFX")
	AudioServer.set_bus_send(sfx, "Master")
	AudioServer.set_bus_volume_db(sfx, -4.0)
	var reverb := AudioEffectReverb.new()
	reverb.room_size = 0.55
	reverb.damping = 0.6
	reverb.wet = 0.12
	reverb.dry = 1.0
	AudioServer.add_bus_effect(sfx, reverb)
	var limiter := AudioEffectHardLimiter.new()
	limiter.ceiling_db = -1.0
	AudioServer.add_bus_effect(0, limiter)

## Updates the strategic war-tension target (0..1) from diplomacy / DEFCON state.
func set_war_state(at_war: bool, defcon_level := 5) -> void:
	if at_war:
		_war_target = 1.0
	elif defcon_level <= 2:
		_war_target = 0.8
	elif defcon_level == 3:
		_war_target = 0.4
	else:
		_war_target = 0.0

## Plays a one-shot at a world position. `size` scales how far it carries.
func play(name: String, at: Vector3, volume_db := 0.0, size := 1.0) -> void:
	if name in ["rifle", "mg_burst", "cannon", "artillery_fire", "missile_launch", "explosion", "nuke_blast"] and at.distance_to(_focus) < 240.0:
		_battle_hold = 18.0
	var count: int = _recent.get(name, 0)
	if count >= 4:
		return
	_recent[name] = count + 1
	var key: String = name
	if VARIANTS.has(name):
		key = "%s_%d" % [name, randi_range(1, VARIANTS[name])]
	var stream = _streams.get(key)
	if stream == null:
		stream = _streams.get("explosion_1" if name == "nuke_blast" else ("cannon" if name in ["artillery_fire", "missile_launch"] else "rifle_1"))
	if stream == null:
		return
	var p := _pool[_next]
	_next = (_next + 1) % POOL_SIZE
	p.stream = stream
	p.unit_size = 14.0 * size
	p.volume_db = volume_db
	p.pitch_scale = randf_range(0.92, 1.08)
	p.global_position = at
	p.play()

## A looping engine tailored to unit class: "vehicle", "tank", "jet", "heli", or "ship".
func add_engine(parent: Node3D, kind := "vehicle") -> AudioStreamPlayer3D:
	var p := AudioStreamPlayer3D.new()
	var stream_key: String = {
		"tank": "tank_loop",
		"jet": "jet_loop",
		"heli": "heli_loop",
		"ship": "ship_loop",
	}.get(kind, "engine_loop")
	p.stream = _streams.get(stream_key, _streams.get("engine_loop"))
	p.bus = "SFX"
	match kind:
		"jet":
			p.unit_size = 14.0
			p.max_distance = 260.0
			p.volume_db = -18.0
		"heli":
			p.unit_size = 12.0
			p.max_distance = 220.0
			p.volume_db = -16.0
		"ship":
			p.unit_size = 13.0
			p.max_distance = 220.0
			p.volume_db = -17.0
		"tank":
			p.unit_size = 11.0
			p.max_distance = 190.0
			p.volume_db = -16.0
		_:
			p.unit_size = 10.0
			p.max_distance = 180.0
			p.volume_db = -17.0
	p.pitch_scale = randf_range(0.92, 1.04)
	parent.add_child(p)
	if p.stream != null:
		p.play(randf() * 1.5)
	return p

func engine_update(engine: AudioStreamPlayer3D, moving: bool, delta: float, kind := "vehicle") -> void:
	var loud := -8.0 if moving else -18.0
	var pitch := 1.12 if moving else 0.88
	if kind == "jet":
		loud = -7.0 if moving else -22.0
		pitch = 1.16 if moving else 0.82
	elif kind == "heli":
		loud = -8.0 if moving else -13.0
		pitch = 1.06 if moving else 0.94
	elif kind == "ship":
		loud = -9.0 if moving else -19.0
		pitch = 1.05 if moving else 0.86
	engine.volume_db = lerpf(engine.volume_db, loud, minf(1.0, delta * 2.0))
	engine.pitch_scale = lerpf(engine.pitch_scale, pitch, minf(1.0, delta * 1.5))

## Listener on the ground at the camera focus, facing the camera's way.
## `coast` is the nearest shoreline point, where the surf plays from.
func follow(focus: Vector3, camera: Camera3D, coast: Vector3) -> void:
	_focus = focus
	_recent.clear()
	_listener.global_transform = Transform3D(camera.global_basis, focus + Vector3.UP * 2.0)
	_surf.global_position = coast

## Real-time crossfade, independent of 1x/4x simulation speed.
func _process(delta: float) -> void:
	delta /= maxf(Engine.time_scale, 0.001)
	_battle_hold = maxf(0.0, _battle_hold - delta)
	_battle_mix = move_toward(_battle_mix, 1.0 if _battle_hold > 0.0 else 0.0, delta / 6.0)
	_war_tension = move_toward(_war_tension, _war_target, delta / 5.0)
	if _music != null and _battle_music != null:
		var peace_w := (1.0 - _battle_mix) * (1.0 - _war_tension * 0.72)
		var tension_w := (1.0 - _battle_mix) * _war_tension
		_music.volume_db = linear_to_db(maxf(0.0001, peace_w * db_to_linear(-9.0)))
		if _tension_music != null and _tension_music.stream != null:
			_tension_music.volume_db = linear_to_db(maxf(0.0001, tension_w * db_to_linear(-11.0)))
		_battle_music.volume_db = linear_to_db(maxf(0.0001, _battle_mix * db_to_linear(-12.0)))

func diplomatic_feedback(kind: String) -> void:
	if _feedback != null and _cues.has(kind):
		_feedback.stream = _cues[kind]
		_feedback.play()

static func _cue(kind: String) -> AudioStreamWAV:
	var rate := 22050
	var data := PackedByteArray()
	data.resize(int(rate * 0.32) * 2)
	var pitches: Array = {"ready": [440.0, 554.37], "accepted": [523.25, 659.25], "rejected": [392.0, 293.66], "counter": [440.0, 493.88], "alert": [698.46, 523.25]}[kind]
	for i in range(data.size() / 2):
		var t := float(i) / rate
		var age := fmod(t, 0.16)
		var env := smoothstep(0.0, 0.008, age) * exp(-age * 24.0) * (1.0 - smoothstep(0.12, 0.16, age))
		data.encode_s16(i * 2, int(sin(TAU * float(pitches[mini(1, int(t / 0.16))]) * age) * env * 8000.0))
	var wav := AudioStreamWAV.new()
	wav.format = AudioStreamWAV.FORMAT_16_BITS
	wav.mix_rate = rate
	wav.data = data
	return wav
