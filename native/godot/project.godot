; DOMINION desktop engine evaluation. Open with Godot 4.7.2.
config_version=5

[application]
config/name="DOMINION"
config/description="A real-time strategy game of nations, cities, supply lines, research and war."
config/version="0.9.18"
run/main_scene="res://world.tscn"
config/icon="res://icon.png"
config/windows_native_icon="res://icon.ico"
config/use_custom_user_dir=true
config/custom_user_dir_name="DOMINION"
boot_splash/bg_color=Color(0.0667, 0.1216, 0.1451, 1)
boot_splash/image="res://icon.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/screen_space_aa=1
textures/default_filters/anisotropic_filtering_level=2
environment/ssao/quality=1
environment/ssao/half_size=true
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
environment/defaults/default_clear_color=Color(0.09,0.13,0.17,1)

[input]
